DATABASE_URL=postgres://leaveboard:leaveboard@localhost:5432/leaveboard
PORT=3001

# Origins allowed to call this API, comma separated. Required in production, where the
# server refuses to start without it. Unset in development, every origin is reflected.
CLIENT_ORIGIN=http://localhost:5173

# Managed Postgres wants TLS; the local container does not offer it.
DATABASE_SSL=false

# Requests per IP per 15 minutes. Generous for a person using the app, low enough to be a
# speed bump for anything automated.
RATE_LIMIT_MAX=300
